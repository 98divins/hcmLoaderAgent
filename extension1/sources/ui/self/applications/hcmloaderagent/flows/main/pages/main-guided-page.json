{
  "title": "",
  "description": "",
  "variables": {
    "cancel": {
      "type": "boolean",
      "defaultValue": false
    },
    "completionPanelBackgroundImageIndex": {
      "type": "number",
      "defaultValue": 0,
      "persisted": "device"
    },
    "currentStep": {
      "type": "string",
      "defaultValue": "",
      "input": "fromUrl"
    },
    "dirtyDataFlag": {
      "type": "boolean",
      "defaultValue": false
    },
    "dirtyDialogOpen": {
      "type": "boolean",
      "defaultValue": false
    },
    "valid": {
      "type": "string"
    }
  },
  "metadata": {},
  "types": {
    "step": {
      "id": "string",
      "title": "string",
      "description": "string",
      "display": "string",
      "status": "string",
      "timestamp": "string",
      "optional": "boolean"
    }
  },
  "eventListeners": {
    "onConfirmNoOjAction": {
      "chains": [
        {
          "chain": "dialogResponseActionChain",
          "parameters": {
            "detail": "{{ $event.detail }}",
            "response": "NO"
          }
        }
      ]
    },
    "onConfirmYesOjAction": {
      "chains": [
        {
          "chain": "dialogResponseActionChain",
          "parameters": {
            "detail": "{{ $event.detail }}",
            "response": "YES"
          }
        }
      ]
    },
    "onSpBeforeStepNavigate": {
      "preventDefault": "true",
      "chains": [
        {
          "chain": "spBeforeStepNavigate",
          "parameters": {
            "event": "{{ $event }}"
          }
        }
      ]
    },
    "onSpCancel": {
      "chains": [
        {
          "chain": "spCancelActionChain",
          "parameters": {
            "detail": "{{ $event.detail }}"
          }
        }
      ]
    },
    "vbBeforeExit": {
      "chains": [
        {
          "chain": "checkBeforeExitActionChain",
          "parameters": {}
        }
      ]
    },
    "vbEnter": {
      "chains": [
        {
          "chain": "firePageLayoutEventActionChain"
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-sp-completion-panel": {
        "path": "oj-sp/completion-panel/loader"
      },
      "oj-sp-guided-process": {
        "path": "oj-sp/guided-process/loader"
      },
      "oj-sp-message-unsaved-changes": {
        "path": "oj-sp/message-unsaved-changes/loader"
      },
      "oj-validation-group": {
        "path": "ojs/ojvalidationgroup"
      }
    }
  },
  "@dt": {
    "iconClass": "vbdt-dynamic-icon-102-icoPageTemplateSvg"
  }
}
