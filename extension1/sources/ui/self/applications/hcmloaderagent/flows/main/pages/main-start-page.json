{
  "title": "Chargement en masse HCM",
  "description": "Accueil : choisir l'objet a charger et l'operation, puis ouvrir un dossier",
  "variables": {},
  "metadata": {},
  "eventListeners": {
    "onPickHierarchy": {
      "chains": [
        {
          "chain": "flow:pickHierarchyChain",
          "parameters": {
            "event": "[[ $event ]]"
          }
        }
      ]
    },
    "onPickOperation": {
      "chains": [
        {
          "chain": "flow:pickOperationChain",
          "parameters": {
            "event": "[[ $event ]]"
          }
        }
      ]
    },
    "onStart": {
      "chains": [
        {
          "chain": "flow:startDossierChain"
        },
        {
          "chain": "flow:goToPageChain",
          "parameters": {
            "page": "import",
            "when": "opened"
          }
        },
        {
          "chain": "flow:loadLookupsChain"
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-c-button": {
        "path": "oj-c/button"
      },
      "oj-c-message-banner": {
        "path": "oj-c/message-banner"
      }
    }
  }
}
