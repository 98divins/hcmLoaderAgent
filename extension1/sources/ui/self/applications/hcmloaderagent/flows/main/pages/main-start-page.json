{
  "title": "Chargement en masse HCM",
  "description": "Poste de travail pour preparer, controler et charger des donnees HCM en masse",
  "types": {
    "turnType": {
      "question": "string",
      "answer": "string",
      "meta": "string"
    }
  },
  "variables": {
    "businessObject": {
      "type": "string",
      "defaultValue": "Location"
    },
    "step": {
      "type": "string",
      "defaultValue": "data"
    },
    "fileName": {
      "type": "string",
      "defaultValue": ""
    },
    "columns": {
      "type": "string[]",
      "defaultValue": []
    },
    "rows": {
      "type": "object[]",
      "defaultValue": []
    },
    "countTotal": {
      "type": "number",
      "defaultValue": 0
    },
    "countIssues": {
      "type": "number",
      "defaultValue": 0
    },
    "summaryText": {
      "type": "string",
      "defaultValue": ""
    },
    "hasProposal": {
      "type": "boolean",
      "defaultValue": false
    },
    "proposalText": {
      "type": "string",
      "defaultValue": ""
    },
    "proposalJson": {
      "type": "string",
      "defaultValue": ""
    },
    "question": {
      "type": "string",
      "defaultValue": ""
    },
    "pendingQuestion": {
      "type": "string",
      "defaultValue": ""
    },
    "isThinking": {
      "type": "boolean",
      "defaultValue": false
    },
    "aborted": {
      "type": "boolean",
      "defaultValue": false
    },
    "errorText": {
      "type": "string",
      "defaultValue": ""
    },
    "conversationId": {
      "type": "string",
      "defaultValue": ""
    },
    "turns": {
      "type": "turnType[]",
      "defaultValue": []
    },
    "agentSteps": {
      "type": "string[]",
      "defaultValue": []
    },
    "currentStep": {
      "type": "string",
      "defaultValue": ""
    },
    "assistOpen": {
      "type": "boolean",
      "defaultValue": true
    },
    "hasAutoFix": {
      "type": "boolean",
      "defaultValue": false
    },
    "autoFixText": {
      "type": "string",
      "defaultValue": ""
    },
    "autoFixJson": {
      "type": "string",
      "defaultValue": ""
    },
    "appliedNote": {
      "type": "string",
      "defaultValue": ""
    },
    "isLoading": {
      "type": "boolean",
      "defaultValue": false
    },
    "loadStatus": {
      "type": "string",
      "defaultValue": ""
    },
    "loadDetail": {
      "type": "string",
      "defaultValue": ""
    },
    "requestId": {
      "type": "string",
      "defaultValue": ""
    },
    "dataSetName": {
      "type": "string",
      "defaultValue": ""
    },
    "isPolling": {
      "type": "boolean",
      "defaultValue": false
    },
    "loadRows": {
      "type": "object[]",
      "defaultValue": []
    },
    "loadColumns": {
      "type": "string[]",
      "defaultValue": []
    },
    "loadPhases": {
      "type": "object[]",
      "defaultValue": []
    },
    "objectCatalog": {
      "type": "object",
      "defaultValue": {
        "keyResolutionOrder": [
          "guid",
          "sourceKey",
          "userKey"
        ],
        "objects": {
          "Location": {
            "name": "Location",
            "fileDiscriminator": "Location",
            "supportedActions": [
              "MERGE"
            ],
            "supportedActionsLabel": "Create and update only",
            "requiredForNewRecords": true,
            "userKey": [
              "LocationCode",
              "SetCode"
            ],
            "attributes": [
              {
                "name": "LocationId",
                "type": "Number",
                "keyType": "surrogateId",
                "required": "always",
                "note": "Identifiant interne, disponible seulement en mise a jour. Ne pas fournir en creation."
              },
              {
                "name": "LocationCode",
                "type": "String",
                "keyType": "userKey",
                "required": "newRecords"
              },
              {
                "name": "SetCode",
                "type": "String",
                "keyType": "userKey",
                "required": "no"
              },
              {
                "name": "EffectiveStartDate",
                "type": "Date",
                "required": "always"
              },
              {
                "name": "EffectiveEndDate",
                "type": "Date",
                "required": "no"
              },
              {
                "name": "LocationName",
                "type": "String",
                "required": "newRecords"
              },
              {
                "name": "ActiveStatus",
                "type": "String",
                "required": "newRecords",
                "lookup": "ACTIVE_INACTIVE"
              },
              {
                "name": "Country",
                "type": "String",
                "required": "newRecords"
              },
              {
                "name": "SetId",
                "type": "Number",
                "keyType": "foreignObjectReference",
                "required": "newRecords",
                "referenceUserKey": [
                  "SetCode"
                ]
              },
              {
                "name": "AddressLine1",
                "type": "String",
                "required": "no"
              },
              {
                "name": "AddressLine2",
                "type": "String",
                "required": "no"
              },
              {
                "name": "AddressLine3",
                "type": "String",
                "required": "no"
              },
              {
                "name": "AddressLine4",
                "type": "String",
                "required": "no"
              },
              {
                "name": "TownOrCity",
                "type": "String",
                "required": "no"
              },
              {
                "name": "Region1",
                "type": "String",
                "required": "no"
              },
              {
                "name": "Region2",
                "type": "String",
                "required": "no"
              },
              {
                "name": "Region3",
                "type": "String",
                "required": "no"
              },
              {
                "name": "PostalCode",
                "type": "String",
                "required": "no"
              },
              {
                "name": "LongPostalCode",
                "type": "String",
                "required": "no"
              },
              {
                "name": "Description",
                "type": "String",
                "required": "no"
              },
              {
                "name": "Building",
                "type": "String",
                "required": "no"
              },
              {
                "name": "FloorNumber",
                "type": "String",
                "required": "no"
              },
              {
                "name": "EmailAddress",
                "type": "String",
                "required": "no"
              },
              {
                "name": "TimezoneName",
                "type": "String",
                "keyType": "userKey",
                "required": "no"
              },
              {
                "name": "Latitude",
                "type": "Number",
                "required": "no"
              },
              {
                "name": "Longitude",
                "type": "Number",
                "required": "no"
              },
              {
                "name": "SourceSystemId",
                "type": "String",
                "keyType": "sourceKey",
                "required": "no"
              },
              {
                "name": "SourceSystemOwner",
                "type": "String",
                "keyType": "sourceKey",
                "required": "no"
              },
              {
                "name": "GUID",
                "type": "String",
                "keyType": "guid",
                "required": "no",
                "note": "Disponible seulement pour referencer un enregistrement existant."
              }
            ]
          }
        }
      }
    }
  },
  "metadata": {},
  "eventListeners": {
    "onFilePick": {
      "chains": [
        {
          "chain": "importFileChain",
          "parameters": {
            "files": "[[ Array.prototype.slice.call($event.detail.files) ]]"
          }
        }
      ]
    },
    "onCheck": {
      "chains": [
        {
          "chain": "checkPlanChain",
          "parameters": {
            "ask": true
          }
        },
        {
          "chain": "askAgentChain"
        }
      ]
    },
    "onAsk": {
      "chains": [
        {
          "chain": "askAgentChain"
        }
      ]
    },
    "onApplyProposal": {
      "chains": [
        {
          "chain": "applyProposalChain"
        },
        {
          "chain": "checkPlanChain",
          "parameters": {
            "ask": false
          }
        }
      ]
    },
    "onIgnoreProposal": {
      "chains": [
        {
          "chain": "ignoreProposalChain"
        }
      ]
    },
    "onReset": {
      "chains": [
        {
          "chain": "resetChain"
        }
      ]
    },
    "onStop": {
      "chains": [
        {
          "chain": "stopChain"
        }
      ]
    },
    "onToggleAssist": {
      "chains": [
        {
          "chain": "toggleAssistChain"
        }
      ]
    },
    "onExport": {
      "chains": [
        {
          "chain": "exportPlanChain"
        }
      ]
    },
    "onApplyAutoFix": {
      "chains": [
        {
          "chain": "applyProposalChain",
          "parameters": {
            "source": "auto"
          }
        },
        {
          "chain": "checkPlanChain",
          "parameters": {
            "ask": false
          }
        }
      ]
    },
    "onIgnoreAutoFix": {
      "chains": [
        {
          "chain": "ignoreProposalChain",
          "parameters": {
            "source": "auto"
          }
        }
      ]
    },
    "onSubmitLoad": {
      "chains": [
        {
          "chain": "submitLoadChain"
        },
        {
          "chain": "checkLoadStatusChain",
          "parameters": {
            "auto": true
          }
        },
        {
          "chain": "askAgentChain"
        }
      ]
    },
    "onDownloadDat": {
      "chains": [
        {
          "chain": "downloadDatChain"
        }
      ]
    },
    "onCheckLoad": {
      "chains": [
        {
          "chain": "checkLoadStatusChain",
          "parameters": {
            "auto": false
          }
        },
        {
          "chain": "askAgentChain"
        }
      ]
    },
    "onBackToPlan": {
      "chains": [
        {
          "chain": "backToPlanChain"
        }
      ]
    },
    "onAutoCheckLoad": {
      "chains": [
        {
          "chain": "checkLoadStatusChain",
          "parameters": {
            "auto": true
          }
        },
        {
          "chain": "askAgentChain"
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-c-input-text": {
        "path": "oj-c/input-text"
      },
      "oj-c-button": {
        "path": "oj-c/button"
      },
      "oj-c-progress-circle": {
        "path": "oj-c/progress-circle"
      },
      "oj-c-file-picker": {
        "path": "oj-c/file-picker"
      },
      "oj-c-table": {
        "path": "oj-c/table"
      }
    }
  }
}
