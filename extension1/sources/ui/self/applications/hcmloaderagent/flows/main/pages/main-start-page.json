{
  "title": "Chargement en masse HCM",
  "description": "Accueil (template Redwood Welcome) : choisir l'objet et l'operation, puis ouvrir le dossier",
  "variables": {
    "backgroundColor": {
      "type": "string",
      "defaultValue": "dark-ocean"
    },
    "illustrationBackground": {
      "type": "string",
      "defaultValue": "https://static.oracle.com/cdn/fnd/gallery/2307.0.2/images/illust-welcome-banner-bg-01.png"
    },
    "illustrationForeground": {
      "type": "string",
      "defaultValue": "https://static.oracle.com/cdn/fnd/gallery/2307.0.2/images/illust-welcome-banner-fg-01.png"
    },
    "imageStretch": {
      "type": "string",
      "defaultValue": "none"
    },
    "mobileImage": {
      "type": "string",
      "defaultValue": "on"
    }
  },
  "metadata": {},
  "types": {},
  "eventListeners": {
    "onPickHierarchy": {
      "chains": [
        {
          "chain": "pickHierarchyChain",
          "parameters": {
            "event": "[[ $event ]]"
          }
        }
      ]
    },
    "onPickOperation": {
      "chains": [
        {
          "chain": "pickOperationChain",
          "parameters": {
            "event": "[[ $event ]]"
          }
        }
      ]
    },
    "onStart": {
      "chains": [
        {
          "chain": "sequenceChain",
          "parameters": {
            "steps": [
              {
                "chain": "startDossierChain",
                "params": {}
              },
              {
                "chain": "openDossierChain",
                "params": {}
              }
            ]
          }
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-sp-welcome-page": {
        "path": "oj-sp/welcome-page/loader"
      },
      "oj-c-button": {
        "path": "oj-c/button"
      },
      "oj-c-message-banner": {
        "path": "oj-c/message-banner"
      }
    }
  },
  "@dt": {
    "iconClass": "vbdt-dynamic-icon-109-icoWelcomePageTemplate48Svg"
  }
}
