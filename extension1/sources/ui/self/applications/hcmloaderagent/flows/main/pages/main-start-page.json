{
  "title": "Chargement en masse HCM",
  "description": "Poste de travail pour preparer, controler et charger des donnees HCM en masse",
  "types": {
    "turnType": {
      "question": "string",
      "answer": "string",
      "meta": "string"
    }
  },
  "variables": {
    "businessObject": {
      "type": "string",
      "defaultValue": "Location"
    },
    "step": {
      "type": "string",
      "defaultValue": "data"
    },
    "fileName": {
      "type": "string",
      "defaultValue": ""
    },
    "columns": {
      "type": "string[]",
      "defaultValue": []
    },
    "rows": {
      "type": "object[]",
      "defaultValue": []
    },
    "countTotal": {
      "type": "number",
      "defaultValue": 0
    },
    "countIssues": {
      "type": "number",
      "defaultValue": 0
    },
    "summaryText": {
      "type": "string",
      "defaultValue": ""
    },
    "hasProposal": {
      "type": "boolean",
      "defaultValue": false
    },
    "proposalText": {
      "type": "string",
      "defaultValue": ""
    },
    "proposalJson": {
      "type": "string",
      "defaultValue": ""
    },
    "question": {
      "type": "string",
      "defaultValue": ""
    },
    "pendingQuestion": {
      "type": "string",
      "defaultValue": ""
    },
    "isThinking": {
      "type": "boolean",
      "defaultValue": false
    },
    "aborted": {
      "type": "boolean",
      "defaultValue": false
    },
    "errorText": {
      "type": "string",
      "defaultValue": ""
    },
    "conversationId": {
      "type": "string",
      "defaultValue": ""
    },
    "turns": {
      "type": "turnType[]",
      "defaultValue": []
    },
    "agentSteps": {
      "type": "string[]",
      "defaultValue": []
    },
    "currentStep": {
      "type": "string",
      "defaultValue": ""
    }
  },
  "metadata": {},
  "eventListeners": {
    "onFilePick": {
      "chains": [
        {
          "chain": "importFileChain",
          "parameters": {
            "files": "[[ Array.prototype.slice.call($event.detail.files) ]]"
          }
        }
      ]
    },
    "onCheck": {
      "chains": [
        {
          "chain": "checkPlanChain"
        }
      ]
    },
    "onAsk": {
      "chains": [
        {
          "chain": "askAgentChain"
        }
      ]
    },
    "onApplyProposal": {
      "chains": [
        {
          "chain": "applyProposalChain"
        }
      ]
    },
    "onIgnoreProposal": {
      "chains": [
        {
          "chain": "ignoreProposalChain"
        }
      ]
    },
    "onReset": {
      "chains": [
        {
          "chain": "resetChain"
        }
      ]
    },
    "onStop": {
      "chains": [
        {
          "chain": "stopChain"
        }
      ]
    }
  },
  "imports": {
    "components": {
      "oj-c-input-text": {
        "path": "oj-c/input-text"
      },
      "oj-c-button": {
        "path": "oj-c/button"
      },
      "oj-c-progress-circle": {
        "path": "oj-c/progress-circle"
      },
      "oj-c-file-picker": {
        "path": "oj-c/file-picker"
      },
      "oj-c-table": {
        "path": "oj-c/table"
      }
    }
  }
}
